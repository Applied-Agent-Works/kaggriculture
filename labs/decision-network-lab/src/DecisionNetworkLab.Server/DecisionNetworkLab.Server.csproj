<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DecisionNetworkLab.Core\DecisionNetworkLab.Core.csproj" />
    <ProjectReference Include="..\DecisionNetworkLab.Client\DecisionNetworkLab.Client.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <ClientBundleRoot>$(MSBuildProjectDirectory)\..\DecisionNetworkLab.Client\bin\$(Configuration)\net10.0\publish\wwwroot</ClientBundleRoot>
  </PropertyGroup>

  <Target Name="EnsureClientBundle" BeforeTargets="Build" Condition="!Exists('$(ClientBundleRoot)\index.html')">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\DecisionNetworkLab.Client\DecisionNetworkLab.Client.csproj&quot; -c $(Configuration) --no-restore" />
  </Target>

</Project>
