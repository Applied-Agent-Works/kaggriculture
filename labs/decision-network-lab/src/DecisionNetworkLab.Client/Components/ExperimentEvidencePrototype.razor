@using DecisionNetworkLab.Core

<FluentCard Class="evidence-panel" aria-labelledby="evidence-title">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Phase 2 prototype</p>
            <h2 id="evidence-title">Experiment evidence</h2>
        </div>
        <FluentBadge Appearance="BadgeAppearance.Outline">FROZEN PACKAGE</FluentBadge>
    </div>

    <div class="evidence-intro">
        <strong>@Evidence.ExperimentId</strong>
        <span>@Evidence.Description</span>
        <span class="evidence-note">Descriptive only · not a policy verdict</span>
    </div>

    <div class="evidence-metrics">
        <FluentCard><span>Baseline mean</span><strong>@Evidence.BaselineMeanReward.ToString("0.00")</strong></FluentCard>
        <FluentCard><span>Candidate mean</span><strong>@Evidence.CandidateMeanReward.ToString("0.00")</strong></FluentCard>
        <FluentCard><span>Mean delta</span><strong>+@Evidence.MeanDelta.ToString("0.00")</strong></FluentCard>
        <FluentCard><span>Paired runs</span><strong>@Evidence.PairedRuns</strong></FluentCard>
    </div>

    <div class="evidence-review-grid">
        <div class="evidence-table-wrap">
            <div class="evidence-subheading">
                <h3>Paired runs</h3>
                    <FluentSelect TOption="string" TValue="string" @bind-Value="SelectedPairKey" Label="Inspect trace" Class="evidence-select">
                        @foreach (var pair in Evidence.Pairs)
                        {
                            <FluentOption TOption="string" Value="@PairKey(pair)">Seed @pair.Seed · seat @pair.DecisionPlayer</FluentOption>
                        }
                    </FluentSelect>
            </div>

            <table class="evidence-table">
                <thead>
                    <tr><th>Seed</th><th>Seat</th><th>Baseline</th><th>Candidate</th><th>Delta</th></tr>
                </thead>
                <tbody>
                    @foreach (var pair in Evidence.Pairs)
                    {
                        <tr class="@(PairKey(pair) == SelectedPairKey ? "evidence-row-selected" : string.Empty)">
                            <td>@pair.Seed</td>
                            <td>@pair.DecisionPlayer</td>
                            <td>@pair.BaselineReward.ToString("0")</td>
                            <td>@pair.CandidateReward.ToString("0")</td>
                            <td>+@pair.CandidateMinusBaseline.ToString("0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <FluentCard Class="trace-preview" aria-live="polite">
            <div class="evidence-subheading">
                <h3>Trace preview</h3>
                <span class="trace-label">@SelectedPair.Trace.SourceLabel</span>
            </div>
            <div class="trace-action">@SelectedPair.Trace.Decision</div>
            <div class="trace-facts">
                <span>Step <strong>@SelectedPair.Trace.Step</strong></span>
                <span>Day <strong>@SelectedPair.Trace.Day</strong></span>
                <span>Expected price <strong>@SelectedPair.Trace.ExpectedSalePrice.ToString("0.##")</strong></span>
                <span>Plant utility <strong>@SelectedPair.Trace.PlantUtility.ToString("0.##")</strong></span>
                <span>PASS utility <strong>@SelectedPair.Trace.PassUtility.ToString("0.##")</strong></span>
                <span>Visible ripe carrots <strong>@SelectedPair.Trace.VisibleOpponentRipeCarrots</strong></span>
            </div>
            <p class="trace-explanation">This is action-time evidence from a frozen trace, not a recomputed result.</p>
        </FluentCard>
    </div>

    <p class="evidence-footer">Future versions will load <code>manifest.json</code>, summaries, and traces from the local evidence package.</p>
</FluentCard>
