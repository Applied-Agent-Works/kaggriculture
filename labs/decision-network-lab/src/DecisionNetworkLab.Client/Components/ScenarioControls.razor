@using DecisionNetworkLab.Core

<div class="scenario-controls">
    <div class="preset-row" aria-label="Scenario presets">
        <span class="preset-label">Try a preset</span>
        <FluentButton Appearance="ButtonAppearance.Outline" @onclick="RequestDefault">Default</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Outline" @onclick="RequestTightSeason">Tight season</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Outline" @onclick="RequestLowCare">Low care</FluentButton>
        @if (Network.PricingApproach == PricingApproach.CarrotBeliefModel)
        {
            <FluentButton Appearance="ButtonAppearance.Outline" @onclick="RequestSupplyPressure">Supply pressure</FluentButton>
        }
    </div>

    <div class="field-grid">
        <label class="field range-field">
            <span>Day <output>@Scenario.Day</output></span>
            <FluentSlider TValue="int" Min="0" Max="29" Step="1" Width="100%" @bind-Value="Scenario.Day" @bind-Value:after="NotifyChanged" />
            <small>Move later in the season to test harvest timing.</small>
        </label>

        <label class="field range-field">
            <span>Current price <output>@Scenario.CurrentPrice.ToString("0.##")</output></span>
            <FluentSlider TValue="decimal" Min="0" Max="@PriceMaximum" Step="1" Width="100%" @bind-Value="Scenario.CurrentPrice" @bind-Value:after="NotifyChanged" />
            <small>Drag the quote instead of typing a new number.</small>
        </label>

        <label class="field range-field">
            <span>Future price multiplier <output>@Scenario.FuturePriceMultiplier.ToString("0.00")</output></span>
            <FluentSlider TValue="decimal" Min="0" Max="@(2m)" Step="@(0.05m)" Width="100%" @bind-Value="Scenario.FuturePriceMultiplier" @bind-Value:after="NotifyChanged" />
            <small>1.00 keeps the current quote unchanged.</small>
        </label>

        <label class="field range-field">
            <span>Care success <output>@Scenario.CareSuccessProbability.ToString("P0")</output></span>
            <FluentSlider TValue="decimal" Min="0" Max="1" Step="@(0.05m)" Width="100%" @bind-Value="Scenario.CareSuccessProbability" @bind-Value:after="NotifyChanged" />
            <small>Lower the chance to see crop risk affect the decision.</small>
        </label>

        @if (Network.PricingApproach == PricingApproach.CarrotBeliefModel)
        {
            <label class="field range-field">
                <span>Visible mature opponent crops <output>@Scenario.VisibleOpponentMatureCrops</output></span>
                <FluentSlider TValue="int" Min="0" Max="8" Step="1" Width="100%" @bind-Value="Scenario.VisibleOpponentMatureCrops" @bind-Value:after="NotifyChanged" />
                <small>More visible crops add supply pressure.</small>
            </label>

            <label class="field range-field">
                <span>Active demand sources <output>@Scenario.ActiveDemandSources</output></span>
                <FluentSlider TValue="int" Min="0" Max="2" Step="1" Width="100%" @bind-Value="Scenario.ActiveDemandSources" @bind-Value:after="NotifyChanged" />
                <small>More demand sources support the price belief.</small>
            </label>
        }
    </div>

    <div class="fixed-facts">
        <h3>Fixed game facts</h3>
        <ul>
            @foreach (var fact in Network.FixedFacts)
            {
                <li><span>@fact.Label</span><strong>@fact.Value</strong></li>
            }
        </ul>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public DecisionNetworkDefinition Network { get; set; } = default!;

    [Parameter, EditorRequired]
    public DecisionScenario Scenario { get; set; } = default!;

    [Parameter]
    public EventCallback Changed { get; set; }

    [Parameter]
    public EventCallback<string> PresetRequested { get; set; }

    private int PriceMaximum => Network.CropCode == "MELON" ? 500 : 100;

    private Task NotifyChanged() => Changed.InvokeAsync();

    private Task RequestDefault() => PresetRequested.InvokeAsync("default");

    private Task RequestTightSeason() => PresetRequested.InvokeAsync("tight-season");

    private Task RequestLowCare() => PresetRequested.InvokeAsync("low-care");

    private Task RequestSupplyPressure() => PresetRequested.InvokeAsync("supply-pressure");
}
