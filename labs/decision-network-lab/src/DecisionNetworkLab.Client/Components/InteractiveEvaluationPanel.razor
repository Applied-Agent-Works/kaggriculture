@using DecisionNetworkLab.Core
@using Microsoft.AspNetCore.Components.Web

<FluentCard Class="result-panel" aria-labelledby="result-title" aria-live="polite">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Evaluation</p>
            <h2 id="result-title">Recommendation: @Result.Recommendation</h2>
        </div>
        <span class="recommendation recommendation-@Result.Recommendation.ToLowerInvariant()">@Result.Recommendation</span>
    </div>

    <div class="action-comparison" aria-label="Action comparison">
        @foreach (var action in Result.Actions)
        {
            <FluentCard Class="@ActionCardClass(action)">
                <div class="action-card-heading">
                    <span>@action.Action</span>
                    @if (action.IsRecommended)
                    {
                        <strong>chosen</strong>
                    }
                </div>
                <output>@action.Utility.ToString("0.##")</output>
                <small>@(action.IsAvailable ? action.Explanation : "Not available in this time window.")</small>
            </FluentCard>
        }
    </div>

    <div class="evaluation-facts">
        <FluentCard><span>Expected yield</span><strong>@Result.ExpectedYield.ToString("0.##")</strong></FluentCard>
        <FluentCard><span>Expected price</span><strong>@Result.PriceBelief.ExpectedPrice.ToString("0.##")</strong></FluentCard>
    </div>

    <div class="trace-heading">
        <div>
            <h3>Decision trace</h3>
            <p class="help-text">The trace follows the same evidence-to-decision order as the diagram.</p>
        </div>
    </div>

    <ol class="decision-trace">
        @foreach (var step in Result.Trace)
        {
            <li class="decision-trace-step">
                <span class="trace-step-number">@step.Order</span>
                <div>
                    <div class="trace-step-heading"><strong>@step.Label</strong><span>@step.Value</span></div>
                    <p>@step.Explanation</p>
                </div>
            </li>
        }
    </ol>

    <div class="simulation-launch">
        <div>
            <h3>Run the local simulator</h3>
            <p class="help-text">This is a seeded teaching run, separate from the Python batch evaluator.</p>
        </div>
        <div class="simulation-controls">
            <label class="seed-field">
                <span>Seed</span>
                <FluentNumberInput TValue="int" Label="Seed" @bind-Value="Seed" @bind-Value:after="NotifySeedChanged" />
            </label>
            <FluentButton Appearance="ButtonAppearance.Primary" @onclick="RunSimulation">Run simulation</FluentButton>
        </div>
    </div>

    @if (Simulation is not null)
    {
        <FluentCard Class="simulation-result">
            <div class="simulation-result-heading">
                <div>
                    <p class="eyebrow">Seeded run @Simulation.Seed</p>
                    <h3>@Simulation.Outcome</h3>
                </div>
                <strong>@Simulation.FinalReward.ToString("0.##") reward</strong>
            </div>
            <ol class="simulation-steps">
                @foreach (var step in Simulation.Steps)
                {
                    <li>
                        <span>@step.Order</span>
                        <div><strong>@step.Label</strong><p>@step.Detail</p></div>
                    </li>
                }
            </ol>
        </FluentCard>
    }
</FluentCard>

@code {
    [Parameter, EditorRequired]
    public DecisionResult Result { get; set; } = default!;

    [Parameter]
    public SimulationRun? Simulation { get; set; }

    [Parameter]
    public int Seed { get; set; }

    [Parameter]
    public EventCallback<int> SeedChanged { get; set; }

    [Parameter]
    public EventCallback RunSimulation { get; set; }

    private Task NotifySeedChanged() => SeedChanged.InvokeAsync(Seed);

    private static string ActionCardClass(DecisionActionValue action) =>
        $"action-card {(action.IsRecommended ? "action-card-recommended" : string.Empty)} {(action.IsAvailable ? string.Empty : "action-card-unavailable")}";

}
