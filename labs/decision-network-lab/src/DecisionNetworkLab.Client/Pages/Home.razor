@page "/"
@using DecisionNetworkLab.Core

<PageTitle>Decision Network Lab</PageTitle>

<section class="lab-intro">
    <p class="eyebrow">Kaggriculture learning tool</p>
    <h1>Decision Network Lab</h1>
    <p class="lead">
        Change one visible assumption at a time and see how it affects the
        explicit choice between planting a crop and passing.
    </p>
</section>

<div class="experience-layout">
<FluentCard Class="@DiagramPanelClass" aria-labelledby="diagram-title">
    <div class="network-picker" aria-labelledby="network-picker-title">
        <div>
            <h2 id="network-picker-title">Choose a crop network</h2>
            <p class="help-text">Carrot shows the first coarse belief model. Wheat and melon begin with point-price estimates.</p>
        </div>
        <FluentSelect TOption="string" TValue="string" @bind-Value="SelectedNetworkId" Label="Crop network" Class="compact-field">
            @foreach (var network in Networks)
            {
                <FluentOption TOption="string" Value="@network.Id">@network.Name</FluentOption>
            }
        </FluentSelect>
    </div>

    <div class="section-heading">
        <div>
            <p class="eyebrow">Structure</p>
            <h2 id="diagram-title">@CurrentNetwork.Name decision network</h2>
        </div>
        <div class="diagram-actions">
            <span class="help-text">Arrows describe information flow, not code dependencies.</span>
            <FluentButton Appearance="ButtonAppearance.Outline" @onclick="ToggleDiagramExpanded">
                @(DiagramExpanded ? "Close full view" : "Open full view")
            </FluentButton>
        </div>
    </div>
    <DecisionNetworkDiagram Network="CurrentNetwork" />
</FluentCard>

<div class="workspace-grid">
    <FluentCard Class="scenario-panel" aria-labelledby="scenario-title">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Inputs</p>
                <h2 id="scenario-title">Explore a scenario</h2>
            </div>
            <FluentBadge>@CurrentNetwork.PricingApproach</FluentBadge>
        </div>

        <p>@CurrentNetwork.Summary</p>
        <ScenarioControls Network="CurrentNetwork"
                          Scenario="CurrentScenario"
                          Changed="HandleScenarioChanged"
                          PresetRequested="ApplyPreset" />
    </FluentCard>

    <InteractiveEvaluationPanel Result="Result"
                                Simulation="Simulation"
                                @bind-Seed="SimulationSeed"
                                RunSimulation="RunSimulation" />
</div>

<ExperimentEvidencePrototype Evidence="Evidence" />
</div>
